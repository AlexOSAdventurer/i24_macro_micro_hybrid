<?xml version="1.0" encoding="UTF-8"?>
<!--
  Baseline demand for the 1-mile I-24 corridor.

  Routes follow the two through-paths the OpenDRIVE map defines:
    eastbound (road 1): -5 -> -1 -> -3
    westbound (road 2): -6 -> -2 -> -4
  where edge "-N" is OpenDRIVE road N (right-hand lanes), and SUMO lane index
  maps to OpenDRIVE lane id as  sumo_index = 4 + lane_id.

  This is a plain free-flow load for standalone runs and for smoke-testing the
  network. When the corridor is driven by the macroscopic simulation, vehicle
  insertion is governed by the coupler instead and these flows are not used.
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Passenger-car defaults; length/minGap left at SUMO defaults so the
         calibrated CARLA spawn geometry can be mirrored here later. -->
    <vType id="car" vClass="passenger" carFollowModel="IDM"
           accel="1.5" decel="2.0" emergencyDecel="9.0" sigma="0.5"
           tau="1.0" minGap="2.5" length="4.5" maxSpeed="33.5"
           speedFactor="normc(1.0,0.1,0.8,1.2)"/>

    <route id="eastbound" edges="-5 -1 -3"/>
    <route id="westbound" edges="-6 -2 -4"/>

    <!-- ~1200 veh/h/lane over 4 lanes; adjust per experiment. -->
    <flow id="flow_westbound" route="westbound" type="car"
          begin="0" end="3600" vehsPerHour="4800" departLane="random" departSpeed="max"/>
    <flow id="flow_eastbound" route="eastbound" type="car"
          begin="0" end="3600" vehsPerHour="4800" departLane="random" departSpeed="max"/>

</routes>
